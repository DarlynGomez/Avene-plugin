{
  "name": "cadt-figma-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,json,ts,html}\" .prettierrc",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,json,ts,html}\" .prettierrc",
    "teach:generate": "vite-node tools/teach-me-why/generate.ts",
    "teach:import": "vite-node tools/teach-me-why/importCli.ts",
    "teach:coverage": "vite-node tools/teach-me-why/coverage.ts",
    "teach:flags": "vite-node tools/teach-me-why/flags.ts",
    "teach:revalidate": "vite-node tools/teach-me-why/revalidateCli.ts"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@figma/plugin-typings": "^1.123.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "jsdom": "^26.1.0",
    "openai": "^6.49.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
